__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env
.env.*
!.env.example

# data & model artifacts
data/raw/
data/synthetic/generated/
sample_reports/**/images/
artifacts/
**/artifacts/
*.ckpt
*.pt
*.gguf
*.onnx
*.safetensors
models/checkpoints/

# db
*.sqlite3
pgdata/

# node (frontend + any tooling scripts)
node_modules/
frontend/dist/

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# logs
*.log
logs/

# Uploaded reports. UPLOAD_DIR defaults to /app/uploads, and docker-compose bind-mounts
# services/api to /app - so real users' lab reports land inside the working tree. They are
# patient data and must never be committed.
uploads/
services/api/uploads/

# local SQLite databases (the no-Docker dev path) - also contain report data.
# -wal/-shm are the write-ahead-log sidecar files WAL mode creates next to the database.
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Playwright artifacts
frontend/test-results/
frontend/playwright-report/
