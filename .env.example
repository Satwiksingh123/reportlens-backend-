# Postgres
POSTGRES_USER=reportlens
POSTGRES_PASSWORD=changeme
POSTGRES_DB=reportlens
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://reportlens:changeme@postgres:5432/reportlens

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# How an upload's pipeline runs: celery (production, needs Redis + a worker) |
# thread (local dev, runs in-process on a background thread, no Redis) | inline (tests only;
# blocks the upload response for the whole OCR+LLM run, which looks like a hung app).
PIPELINE_MODE=celery

# Auth
JWT_SECRET_KEY=changeme-generate-a-real-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# LLM (Ollama)
# Must match a model actually pulled into the ollama container
# (docker compose exec ollama ollama pull qwen2.5:3b), otherwise the client reports the
# model unavailable and explanations silently fall back to deterministic templates.
# 3b is the CPU-friendly default; use qwen2.5:7b if you have a GPU.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b

# App
APP_ENV=development
LOG_LEVEL=INFO

# Frontend origins allowed to call this API from a browser (comma-separated).
# Defaults already cover Vite's dev server; add your deployed frontend's URL here too.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
